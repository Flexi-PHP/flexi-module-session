{
  "name": "flexi/flexi-module-session",
  "description": "Session management module for Flexi Framework",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "session",
    "session-management"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1",
    "flexi/flexi-module-logging": "^2.0",
    "psr/log": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\Session\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "Session",
      "module-type": "infrastructure",
      "config-files": [
        "Config/services.json"
      ],
      "provides": [
        "session",
        "session-storage"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\Session\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
